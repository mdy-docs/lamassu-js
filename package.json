{
  "name": "lamassu-js-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for the lamassu-js engine package and the documentation site, which hosts the REPL playground.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "docs-site"
  ],
  "scripts": {
    "build:wasm": "make pkg",
    "build:docs": "npm run build --workspace @mdy-docs/lamassu-docs",
    "build": "npm run build:wasm && npm run build:docs",
    "dev": "npm run dev --workspace @mdy-docs/lamassu-docs",
    "docs:dev": "npm run dev --workspace @mdy-docs/lamassu-docs",
    "docs:build": "npm run build --workspace @mdy-docs/lamassu-docs",
    "docs:preview": "npm run preview --workspace @mdy-docs/lamassu-docs"
  },
  "license": "MIT"
}
